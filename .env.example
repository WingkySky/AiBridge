# AIBridge 真实 API 测试环境变量
#
# ⚠️ 重要：本文件是模板（.env.example），可上传 GitHub。
#    实际 API key 请填在 .env 文件里（已 gitignore，不会上传 GitHub）。
#
# 用法：
# 1. cp .env.example .env
# 2. 在 .env 填入真实 API key（等号右边）
# 3. python examples/test_real_providers.py
#
# 测试脚本会从 .env 读 key，并用 list_models() 实时拉取真实 model 名字（model 经常变，不硬编码）。

# Agnes AI（https://agnes.ai）
AGNES_API_KEY=
AGNES_BASE_URL=https://api.agnes.ai/v1

# OpenAI（https://platform.openai.com）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini（https://ai.google.dev）
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# 火山引擎 CV / 方舟（https://www.volcengine.com）
# 普通 API base_url 固定 https://ark.cn-beijing.volces.com/api/v3
# 注意：Agent Plan / Coding Plan 是独立订阅，有专属 Base URL 和专属 API Key，与普通方舟 Key 勿混用
# 接入文档：https://www.volcengine.com/docs/82379/2373746
VOLCENGINE_CV_API_KEY=
VOLCENGINE_CV_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 火山引擎 Agent Plan（订阅制，官方暴露两种协议端点，二选一或同时配置均可，同一专属 key 通用）
# 需在控制台订阅并获取 Agent Plan 专属 API Key（与普通方舟 Key 不同）
# 接入文档：https://www.volcengine.com/docs/82379/2373746
#
# 方式一：OpenAI 兼容协议（provider=doubao，model 填 ark-code-latest 或官方支持的模型名）
# AIBRIDGE_DOUBAO_API_KEY=<Agent Plan 专属 key>
# AIBRIDGE_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
#
# 方式二：Anthropic 兼容协议（provider=anthropic，适配 Claude Code 生态）
# base_url 与官方文档写法一致（不带 /v1，SDK 自动补版本前缀，带 /v1 的写法也兼容）
# AIBRIDGE_ANTHROPIC_API_KEY=<Agent Plan 专属 key>
# AIBRIDGE_ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/plan

# 火山方舟接入点 ID（在控制台「模型推理」创建接入点获取，形如 ep-2024xxxxxx-xxxxx）
# 图像模型（doubao-seedream）和视频模型（doubao-seedance）各创建一个接入点
VOLCENGINE_IMAGE_ENDPOINT=
VOLCENGINE_VIDEO_ENDPOINT=
